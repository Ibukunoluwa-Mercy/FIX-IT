# ================================
# FIXIT FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# ================================
# This is a safe-to-commit template. Copy it to .env and fill in your values.
# NEVER commit the actual .env file.

# --- Map Configuration ---
# MapTiler API Key (https://cloud.maptiler.com/account/keys)
VITE_MAPTILER_KEY=your_maptiler_api_key_here

# MapTiler Map Style (streets-v2, outdoor-v2, satellite, dataviz, etc.)
VITE_MAPTILER_STYLE=streets-v2

# --- Geocoding (OpenStreetMap Nominatim - Free, no key needed) ---
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org

# --- Backend API ---
# URL of the FixIt backend server
VITE_API_BASE_URL=http://localhost:5000

# --- App Config ---
VITE_APP_NAME=FixIt
VITE_APP_VERSION=1.0.0
